name: Dev secrets bundle

on:
  workflow_dispatch: {}

permissions:
  contents: read
  actions: read

jobs:
  bundle:
    name: Create dev env bundle
    runs-on: ubuntu-latest
    environment: dev

    steps:
      - name: Build bundle
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p bundle

          # Write .env.local from GitHub Environment secrets
          cat > bundle/.env.local << 'EOF'
          APP_BASE_URL=${{ secrets.APP_BASE_URL }}
          BACKEND_BASE_URL=${{ secrets.BACKEND_BASE_URL }}
          BACKEND_PORT=${{ secrets.BACKEND_PORT }}
          CORS_ORIGIN=${{ secrets.CORS_ORIGIN }}

          DB_HOST=${{ secrets.DB_HOST }}
          DB_PORT=${{ secrets.DB_PORT }}
          DB_USER=${{ secrets.DB_USER }}
          DB_PASSWORD=${{ secrets.DB_PASSWORD }}
          DB_NAME=${{ secrets.DB_NAME }}

          # GitHub OAuth client secret (for auth.providers.github)
          OAUTH_CLIENT_SECRET=${{ secrets.OAUTH_CLIENT_SECRET }}

          # GitHub App credentials (for integrations.github.apps)
          APP_CLIENT_ID=${{ secrets.APP_CLIENT_ID }}
          APP_CLIENT_SECRET=${{ secrets.APP_CLIENT_SECRET }}

          # The setup script will install the PEM at this path inside the repo
          APP_PRIVATE_KEY_FILE=.secrets/app.pem
          EOF

          # Decode PEM into the bundle
          echo "${{ secrets.APP_PRIVATE_KEY_PEM_B64 }}" | base64 -d > bundle/app.pem
          chmod 600 bundle/app.pem

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: dev-secrets-bundle
          path: bundle/
          retention-days: 1
